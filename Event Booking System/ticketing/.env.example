# Development-only defaults. Never commit real secrets.
APP_SESSION_SECRET=replace-with-a-long-random-value
STAFF_EMAIL=staff@hilstonpark.test
STAFF_PASSWORD=ChangeMe-OnlyForLocal-2026!
STAFF_USER_ID=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ticket-pdfs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
DEMO_MODE=true
# Phase 10.1: allow doors staff to admit a booking's guests in more than one group
# (e.g. some guests arrive early). Set to "false" to require checking in every
# remaining guest on a booking in a single scan. Any other value (or unset) = true.
ALLOW_PARTIAL_CHECKIN=true
# Hard blocker: leave false in production until the team explicitly authorises live publishing.
EVENT_PUBLISHING_ENABLED=false
EVENT_DEPLOYMENT_ROLE=staging
# Required only when this code is deliberately deployed to the live website.
LIVE_EVENT_PUBLISHING_AUTHORIZED=false
# Browser clients may read the public feed only from this staging origin by default.
EVENTS_PUBLIC_ORIGIN=https://hilston-park.vercel.app
# Required by the main-site server-side event gateway. Leave this false until a
# specific website deployment has been explicitly approved to show events.
EVENTS_PUBLIC_FEED_ENABLED=false
TICKETING_EVENTS_FEED_KEY=
# Enables /events only when this deployment is the explicitly approved staging
# ticketing environment. It never enables the live Hilston Park website.
EVENT_STOREFRONT_ENABLED=false
